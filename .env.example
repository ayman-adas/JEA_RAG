# ==============================================================================
# Jordan Engineers Association (JEA) RAG Chatbot - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Security & Authentication (Enterprise Zero-Trust)
# ------------------------------------------------------------------------------
# API Keys for user and admin endpoints. Generate secure random keys with:
#   openssl rand -hex 32
ADMIN_API_KEY=your_super_secret_admin_key_here
USER_API_KEY=your_super_secret_user_key_here

# Internal microservice bypass token shared with jea_backend (Node.js/NestJS).
# Sent via 'x-internal-token' header to authenticate internal service calls and
# bypass public rate limiting and working-hours ticket restrictions.
INTERNAL_BYPASS_TOKEN=jea_rag_token

# ------------------------------------------------------------------------------
# 2. jea_backend Ticketing Integration
# ------------------------------------------------------------------------------
# Base URL of the main backend (NestJS). Used to forward escalation tickets to
# POST /api/v1/tickets/internal. Defaults to http://localhost:3000
JEA_BACKEND_URL=http://localhost:3000

# Optional direct override URL for internal ticket submission.
# Defaults to: ${JEA_BACKEND_URL}/api/v1/tickets/internal
# INTERNAL_TICKETS_API_URL=http://localhost:3000/api/v1/tickets/internal

# Optional direct override token for internal ticket submission.
# Defaults to: ${INTERNAL_BYPASS_TOKEN}
# INTERNAL_TICKETS_API_KEY=jea_rag_token


# ------------------------------------------------------------------------------
# 3. Traffic Protection, Rate Limiting & CORS
# ------------------------------------------------------------------------------
# Number of multi-process ASGI worker processes (Uvicorn)
WEB_WORKERS=4

# Maximum requests per minute allowed per client IP address.
# Exceeding this returns HTTP 429 Too Many Requests with Retry-After header.
# Health probes and requests with valid INTERNAL_BYPASS_TOKEN are exempt.
RATE_LIMIT_PER_MINUTE=120

# Comma-separated list of allowed CORS origins.
# Use explicit domains in production (e.g., https://jea.org.jo,https://portal.jea.org.jo)
# Default is '*' for local development.
CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# 4. LLM & Inference Engine (OpenAI / vLLM / Ollama)
# ------------------------------------------------------------------------------
# Active LLM provider for response generation & intent classification:
# Options: "openai" | "vllm" | "ollama"
LLM_PROVIDER=openai

# OpenAI Cloud API Configuration
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Voice agent (GPT-Live-1). Uses the same OPENAI_API_KEY.
# The spoken model stays gpt-live-1. Delegation / tool routing uses gpt-6-luna.
# Knowledge answers are still produced by the RAG pipeline on OPENAI_MODEL.
GPT_LIVE_MODEL=gpt-live-1
GPT_LIVE_VOICE=cedar
GPT_LIVE_DELEGATION_MODEL=gpt-6-luna
GPT_LIVE_SAMPLE_RATE=24000

# Local vLLM Inference Server (OpenAI-compatible)
VLLM_BASE_URL=http://localhost:8001
VLLM_CHAT_URL=http://localhost:8001/v1/chat/completions
VLLM_CHAT_MODEL=jea-chat

# Ollama endpoint used for multi-modal vision parsing & fallback tasks
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=ministral-3:8b
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_KEEP_ALIVE=-1
NUM_CTX=8192
NUM_PREDICT=1280

# ------------------------------------------------------------------------------
# 5. Embeddings, Neural Rewriter & Vector Database
# ------------------------------------------------------------------------------
# Embedding provider: "qwen" (Alibaba-NLP/gte-Qwen2-1.5B-instruct) or "bge-m3"
EMBEDDING_PROVIDER=qwen
QWEN_EMBEDDING_MODEL_NAME=Alibaba-NLP/gte-Qwen2-1.5B-instruct

# AraT5 Dialect Neural Rewriter
ENABLE_ARAT5_REWRITER=true
ARAT5_MODEL_NAME=UBC-NLP/AraT5-base

# Minimum free VRAM (in GB) required on GPU; below this, models run on CPU
MIN_VRAM_GB_EMBEDDER=2.0
MIN_VRAM_GB_RERANKER=2.8
MIN_VRAM_GB_REWRITER=1.5

# ------------------------------------------------------------------------------
# 6. Observability & Debugging
# ------------------------------------------------------------------------------
# If true, exposes internal RAG pipeline profiling & scoring in API JSON responses
EXPOSE_DEBUG_METADATA=false